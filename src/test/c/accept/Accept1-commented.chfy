// You can make inline comments 
BEGIN CROCHET
    CH CH CH CH; // And even comments inside your crochet. Nice crochet tho!
    /*
        And doc your crochet like a pro
    */
    TURN CH CH CH;
    DC DC CH; // Ok this is enough
END CROCHET