Pattern myPattern(Color c, Pattern p) {
    c p p;
    TURN CH CH CH;
    c p p;
    TURN CH CH CH;
    c p p;
};

BEGIN CROCHET
    myPattern(#FF0000, [DC DC SC DC CH]);
    #FAFAFA TURN CH CH CH;
    myPattern(#FFBBBB, [DC DC SC CH CH]);
    #FAFAFA TURN CH CH CH;
    myPattern(#FF0000, [SC CH CH CH SC]);
END CROCHET