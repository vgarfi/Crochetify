Pattern mirrorPat(){
    CH CH CH;
    TURN CH;
    MIRROR([CH SC], 1);
    TURN CH;
    CH CH;
};

Pattern repeatPat(){
    CH CH;
    TURN CH;
    REPEAT([CH], 2);
    TURN CH;
    CH CH;
};

Pattern anidatedRepeatMirror(Pattern p){
    p;
    TURN CH CH CH;
    MIRROR([CH DC], 1);
    TURN CH;
    REPEAT([SC], 2);
};

BEGIN CROCHET
    CH CH CH;
    TURN CH;
    anidatedRepeatMirror(repeatPat());
    TURN CH;
    anidatedRepeatMirror(mirrorPat());
END CROCHET