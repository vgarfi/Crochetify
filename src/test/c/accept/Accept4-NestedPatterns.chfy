Pattern myPattern(Color col, Pattern pattern){
    pattern;
    TURN CH;
    pattern;
};

Color red = #FF0000;

Pattern myPattern2(Color col,Stitch st,Stitch st2){
    st st2 st;
    TURN CH ;
    col CH SC SC;
};

BEGIN CROCHET
    myPattern(red,myPattern2(red,SC,CH)); // computeuse(myPattern) computePattern -> computeUse(myPattern2)
    //TURN CH;
    //myPattern(red,myPattern2(red,CH,CH));
END CROCHET