Color blue = #0000FF;
Pattern myPattern(Color color, Pattern lambda){
    REPEAT([CH],5);
    TURN CH;
    REPEAT([CH],3) SC;
    TURN CH;
    lambda;
};

Pattern mySecondPattern(Stitch s) {
    s s s s s;
    TURN CH;
    s s s s s;
};

BEGIN CROCHET
#5136ca myPattern(blue, [SC SC CH SC SC]);
    TURN CH;
#7b025c mySecondPattern(SC);
END CROCHET

/*
 This is getting awesome! And so colorful
*/