Pattern myPattern4(Stitch s, Stitch s2, Stitch s3, Pattern pattern){
    pattern;
    TURN CH CH CH s;
    pattern;
};

Pattern myPattern(Color col, Pattern pattern){
    pattern;
    TURN CH CH CH;
    col pattern;
};

Color red = #FF0000;

Pattern myPattern2(Color col,Stitch st,Stitch st2){
    st st2 st;
    red TURN CH CH CH;
    col CH CH CH;
};

BEGIN CROCHET
    myPattern(red,[CH CH CH SC SC]);
    TURN CH CH CH;
    myPattern(red,[DC SC CH DC SC]);
END CROCHET