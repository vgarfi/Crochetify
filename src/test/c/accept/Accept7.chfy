Color red = #FF0000;
Color blue = #0000FF;

Pattern myPattern(Color col,Stitch st){
    st st st;
    TURN CH CH CH;
    col CH DC CH;
};

Pattern myPattern2(Color col,Stitch st){
    blue st st st;
    TURN CH CH CH;
    col CH DC CH;
};

BEGIN CROCHET
    myPattern(red,CH);
    TURN CH;
    myPattern(red,CH);
    TURN CH;
END CROCHET