Color red = #FF0000;
Color blue = #0000FF;

Pattern myPattern(Color col,Stitch st){
    st st st;
    TURN CH CH CH;
    col CH DC CH;
};

Pattern myPattern2(Color col,Stitch st){
  #00FF00 st st st;
    TURN CH CH CH;
    col CH DC CH;
};

BEGIN CROCHET
    myPattern(red,SC);
    TURN CH;
    CH SC;
    TURN CH;
    myPattern2(blue,SC);
END CROCHET