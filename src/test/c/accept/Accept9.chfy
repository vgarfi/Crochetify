
Pattern myPattern(Color col,Stitch st){
    st st st;
    TURN CH CH CH;
    col CH DC CH;
};

Color blue = #0000FF;
Color red = #FF0000;

Pattern myPattern2(){
    blue CH CH CH;
    TURN CH CH CH;
    blue CH DC CH;
};

BEGIN CROCHET
    myPattern(red,CH);
    TURN CH;
    myPattern2();
END CROCHET