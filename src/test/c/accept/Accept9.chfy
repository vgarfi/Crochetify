Pattern myPattern(Color col, Stitch st){
    CH CH CH;
    TURN CH;
    st st;
    TURN CH CH CH;
    col CH DC CH;
};

Color blue = #0000FF;
Color red = #FF0000;

Pattern myPattern2(){
    SC CH;
    TURN CH CH CH;
    CH DC;
};

BEGIN CROCHET
    myPattern(red, SC);
    TURN CH;
    myPattern2();
END CROCHET